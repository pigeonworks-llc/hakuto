{
  "expo": {
    "name": "Hakuto",
    "slug": "hakuto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "hakuto",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pigeonworks.hakuto",
      "infoPlist": {
        "NSCameraUsageDescription": "スコアカードをスキャンして自動入力します",
        "NSPhotoLibraryUsageDescription": "アルバムからスコアカード画像を読み込みます"
      }
    },
    "android": {
      "package": "com.pigeonworks.hakuto",
      "adaptiveIcon": {
        "backgroundColor": "#3a5a40",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "スコアカードをスキャンして自動入力します"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "アルバムからスコアカード画像を読み込みます"
        }
      ]
    ]
  }
}
